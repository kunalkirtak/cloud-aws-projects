# Copy to .env and adjust. Never commit .env or real secrets.

# --- Application ---
APP_NAME=AWS S3 + RDS RAG Application
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database ---
# Local Docker PostgreSQL (placeholder credentials for local development only):
DATABASE_URL=postgresql+psycopg://raguser:ragpassword@localhost:5432/ragdb
# Amazon RDS (get the real password from a secret store, keep TLS on):
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<rds-endpoint>:5432/<db>?sslmode=require

# Used by docker-compose.yml for the local PostgreSQL container
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb

# --- Storage ---
# local = read/write data/documents/ (no AWS needed) | s3 = Amazon S3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=data/documents
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_PREFIX=documents/
MAX_UPLOAD_MB=20
# AWS credentials come from an IAM role / AWS_PROFILE - do not put keys in this file.

# --- Embeddings ---
# sentence-transformers = real local model | hash = deterministic test-only backend
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# --- Chunking / retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
DEFAULT_TOP_K=5
# -1 disables score filtering (cosine similarity ranges from -1 to 1)
MIN_SIMILARITY_SCORE=-1

# --- Generation ---
# extractive = deterministic, no LLM (default) | openai_compatible = optional external LLM
GENERATION_PROVIDER=extractive
# Optional, only used when GENERATION_PROVIDER=openai_compatible:
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
